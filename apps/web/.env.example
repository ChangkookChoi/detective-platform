# Pooled least-privilege PostgreSQL URL used by server-side runtime queries.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/detective_platform
# Direct owner URL used only by migration, seed, and deployment verification.
# Leave empty locally to fall back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Direct read-only URL used only by the independent backup runner.
DATABASE_BACKUP_URL=
# Maximum node-postgres clients per application instance (1-10).
DATABASE_POOL_MAX=5

# Clerk manages administrator identity and sessions. Never commit real keys.
# Use pk_test_/sk_test_ together outside production and pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin/reviews

# Comma-separated Clerk user_ IDs. Admin includes reviewer permissions.
CLERK_REVIEWER_USER_IDS=
CLERK_ADMIN_USER_IDS=
# 공개 canonical, sitemap, robots에 사용할 사이트 origin (경로 없이 입력)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NAVER API HUB keys used only by the server-side Python discovery collector.
# Never expose these with a NEXT_PUBLIC_ prefix.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
