# PostgreSQL connection string used by migration, seed, and server-side queries.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/detective_platform

# Clerk manages administrator identity and sessions. Never commit real keys.
# Use pk_test_/sk_test_ together outside production and pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin/reviews

# Comma-separated Clerk user_ IDs. Admin includes reviewer permissions.
CLERK_REVIEWER_USER_IDS=
CLERK_ADMIN_USER_IDS=
